import os
from collections.abc import Iterator, Sequence
from typing import Literal, Unpack, overload

from docboss.formats import Bmp, Html, ImageFormat, Jpeg, Json, Markdown, Png, Ppm, Text, TextFormat

__version__: str

Buffer = bytes | bytearray | memoryview
RenderFormat = Literal["png", "ppm", "bmp", "jpeg", "jpg"]
ImagesMode = Literal["reference", "embed", "omit"]

class DocbossError(Exception): ...

class Metadata:
    title: str | None
    subject: str | None
    creator: str | None
    keywords: str | None
    description: str | None
    last_modified_by: str | None
    revision: str | None
    created: str | None
    modified: str | None
    category: str | None
    application: str | None
    company: str | None
    pages: int | None
    words: int | None
    characters: int | None

class Diagnostic:
    severity: Literal["approximated", "dropped"]
    location: str
    message: str

class FontInfo:
    name: str
    alt_name: str | None
    family: str | None
    pitch: str | None
    embedded: bool

class StyleInfo:
    id: str
    name: str | None
    kind: Literal["paragraph", "character", "table", "numbering"]
    based_on: str | None
    is_default: bool

class Block:
    kind: Literal["paragraph", "heading", "list_item", "table"]
    section: int
    style: str | None
    heading_level: int | None
    list_level: int | None
    list_label: str | None
    text: str

class Image:
    name: str
    file_name: str
    content_type: str
    @property
    def data(self) -> bytes: ...

class Page:
    """One laid-out page. Text formats hold the blocks that start on the page
    and the notes they reference first; image formats render the page."""

    @property
    def index(self) -> int: ...
    @property
    def number(self) -> int: ...
    @overload
    def to(self, spec: TextFormat, /) -> str: ...
    @overload
    def to(self, spec: ImageFormat, /) -> bytes: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Text]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Markdown]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Html]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Json]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Png]) -> bytes: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Ppm]) -> bytes: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Bmp]) -> bytes: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Jpeg]) -> bytes: ...

class Pages:
    """A selection of laid-out pages: indexing gives a Page, slicing a Pages."""

    def __len__(self) -> int: ...
    def __iter__(self) -> Iterator[Page]: ...
    @overload
    def __getitem__(self, key: int) -> Page: ...
    @overload
    def __getitem__(self, key: slice) -> Pages: ...
    @overload
    def to(self, spec: TextFormat, /) -> list[str]: ...
    @overload
    def to(self, spec: ImageFormat, /) -> list[bytes]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Text]) -> list[str]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Markdown]) -> list[str]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Html]) -> list[str]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Json]) -> list[str]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Png]) -> list[bytes]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Ppm]) -> list[bytes]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Bmp]) -> list[bytes]: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Jpeg]) -> list[bytes]: ...

class AsyncPage:
    """One page of an AsyncDocument, resolved when to() runs."""

    @overload
    async def to(self, spec: TextFormat, /) -> str: ...
    @overload
    async def to(self, spec: ImageFormat, /) -> bytes: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Text]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Markdown]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Html]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Json]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Png]) -> bytes: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Ppm]) -> bytes: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Bmp]) -> bytes: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Jpeg]) -> bytes: ...

class AsyncPages:
    """A lazy selection of an AsyncDocument's pages."""

    @overload
    def __getitem__(self, key: int) -> AsyncPage: ...
    @overload
    def __getitem__(self, key: slice) -> AsyncPages: ...
    async def count(self) -> int: ...
    @overload
    async def to(self, spec: TextFormat, /) -> list[str]: ...
    @overload
    async def to(self, spec: ImageFormat, /) -> list[bytes]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Text]) -> list[str]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Markdown]) -> list[str]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Html]) -> list[str]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Json]) -> list[str]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Png]) -> list[bytes]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Ppm]) -> list[bytes]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Bmp]) -> list[bytes]: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Jpeg]) -> list[bytes]: ...


class AsyncDocument:
    """A DOCX or DOC read asynchronously over a file, bytes or an http(s) URL,
    fetching only the byte ranges each call needs."""

    @staticmethod
    async def open(path: str | os.PathLike, *, password: str | None = None) -> AsyncDocument: ...
    @staticmethod
    async def from_bytes(data: Buffer, *, password: str | None = None) -> AsyncDocument: ...
    @staticmethod
    async def open_url(url: str, *, password: str | None = None) -> AsyncDocument: ...
    @property
    def format(self) -> Literal["docx", "doc", "unknown"]: ...
    @property
    def bytes_fetched(self) -> int: ...
    @property
    def requests(self) -> list[tuple[int, int]]: ...
    def part_names(self) -> list[str]: ...
    async def part(self, name: str) -> bytes: ...
    @overload
    async def to(self, spec: TextFormat, /) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Text]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Markdown]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Html]) -> str: ...
    @overload
    async def to(self, spec: None = None, /, **options: Unpack[Json]) -> str: ...
    def pages(self) -> AsyncPages: ...
    def page(self, index: int) -> AsyncPage: ...
    async def extract_text(
        self,
        *,
        list_labels: bool = True,
        headers_footers: bool = False,
        notes: bool = True,
        comments: bool = False,
    ) -> str: ...
    async def extract_markdown(
        self,
        *,
        title: bool = False,
        page_breaks: bool = False,
        images: ImagesMode = "reference",
        image_prefix: str = "",
        headers_footers: bool = False,
        notes: bool = True,
        comments: bool = False,
    ) -> str: ...
    async def extract_html(
        self,
        *,
        standalone: bool = False,
        images: ImagesMode = "embed",
        image_prefix: str = "",
        headers_footers: bool = False,
        notes: bool = True,
        comments: bool = False,
    ) -> str: ...
    async def to_json(self, *, pretty: bool = False) -> str: ...
    async def blocks(self) -> list[Block]: ...
    async def images(self) -> list[Image]: ...
    async def document(self) -> Document: ...

class Document:
    def __init__(
        self,
        path: str | os.PathLike | None = None,
        *,
        data: Buffer | None = None,
        password: str | None = None,
    ) -> None: ...
    @property
    def format(self) -> Literal["docx", "doc"]: ...
    @property
    def metadata(self) -> Metadata: ...
    @property
    def diagnostics(self) -> list[Diagnostic]: ...
    @property
    def fonts(self) -> list[FontInfo]: ...
    @property
    def styles(self) -> list[StyleInfo]: ...
    @overload
    def to(self, spec: TextFormat, /) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Text]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Markdown]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Html]) -> str: ...
    @overload
    def to(self, spec: None = None, /, **options: Unpack[Json]) -> str: ...
    def pages(self) -> Pages: ...
    def page(self, index: int) -> Page: ...
    def extract_text(
        self,
        *,
        list_labels: bool = True,
        headers_footers: bool = False,
        notes: bool = True,
        comments: bool = False,
    ) -> str: ...
    def extract_markdown(
        self,
        *,
        title: bool = False,
        page_breaks: bool = False,
        images: ImagesMode = "reference",
        image_prefix: str = "",
        headers_footers: bool = False,
        notes: bool = True,
        comments: bool = False,
    ) -> str: ...
    def extract_html(
        self,
        *,
        standalone: bool = False,
        images: ImagesMode = "embed",
        image_prefix: str = "",
        headers_footers: bool = False,
        notes: bool = True,
        comments: bool = False,
    ) -> str: ...
    def to_json(self, *, pretty: bool = False) -> str: ...
    def blocks(self) -> list[Block]: ...
    def images(self) -> list[Image]: ...
    def page_count(self) -> int: ...
    def render(
        self,
        page: int = 0,
        *,
        scale: float = 1.0,
        format: RenderFormat = "png",
        jpeg_quality: int = 90,
    ) -> bytes: ...
    def render_pages(
        self,
        pages: Sequence[int] | None = None,
        *,
        scale: float = 1.0,
        format: RenderFormat = "png",
        jpeg_quality: int = 90,
    ) -> list[bytes]: ...
    def to_docx(self) -> bytes: ...
    def save_docx(self, path: str | os.PathLike) -> None: ...

def detect(data: Buffer) -> Literal["docx", "doc", "encrypted_docx", "rtf", "unknown"]: ...
def extract_texts(
    paths: Sequence[str | os.PathLike],
    threads: int | None = None,
    strict: bool = True,
) -> list[str | None]: ...
def md_to_docx(markdown: str, images_dir: str | None = None, title: str | None = None) -> bytes: ...
